FROM node:16-alpine AS build

ENV REACT_APP_BACKEND_URL=http://localhost:8080

WORKDIR /app

COPY code/example-frontend .

RUN npm install \
    && npm run build


FROM node:16-alpine

RUN adduser -D appuser

WORKDIR /app

COPY --from=build --chown=appuser /app/build/ ./

RUN npm install -g serve

EXPOSE 5001

USER appuser

CMD ["serve", "-s", "-l", "5001", "."]
