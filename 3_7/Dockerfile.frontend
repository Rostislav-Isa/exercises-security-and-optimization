FROM node:16-alpine

ENV REACT_APP_BACKEND_URL=http://localhost:8080

WORKDIR /app

COPY code/example-frontend .

RUN adduser -D appuser \
    && npm install \
    && npm run build \
    && rm -rf src \
    && npm install -g serve

EXPOSE 5001

USER appuser

CMD ["serve", "-s", "-l", "5001", "build"]
